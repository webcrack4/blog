/* Resume Language Switcher Styles */
.lang-switch {
  text-align: center;
  margin: 2rem 0;
  padding: 1rem;
  background: #f9f9f9;
  border-radius: 8px;
}

.lang-btn {
  display: inline-block;
  padding: 8px 20px;
  margin: 0 5px;
  border: 1px solid #ddd;
  border-radius: 4px;
  text-decoration: none;
  color: #555;
  background: #fff;
  transition: all 0.3s ease;
  font-size: 14px;
}

.lang-btn:hover {
  background: #f0f0f0;
  border-color: #ccc;
}

.lang-btn.active {
  background: #42b983;
  color: #fff;
  border-color: #42b983;
}
